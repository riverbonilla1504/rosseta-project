# Copiar a frontend/.env.local (NUNCA versionar). Next.js lee el .env de su propia carpeta.
# Referencia: docs/03-arquitectura/08-infraestructura-y-entornos.md §4 y ADR-0007.

# Auth0 (@auth0/nextjs-auth0)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 bytes en hex:  openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.rosetta.local
AUTH0_SCOPE=openid profile email offline_access

# Proxy BFF hacia Django
BACKEND_INTERNAL_URL=http://localhost:8000
