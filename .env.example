# Copiar a .env (NUNCA versionar .env). Lista completa y descripción:
# docs/03-arquitectura/08-infraestructura-y-entornos.md §4

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- Datos (valores de docker-compose.yml para desarrollo local) ---
DATABASE_URL=postgres://rosetta:rosetta_dev_only@localhost:5433/rosetta
REDIS_URL=redis://localhost:6379/0

# --- Autenticación con Auth0 (feature 002, ADR-0007) ---
# Backend y frontend
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Solo frontend (Next.js, @auth0/nextjs-auth0)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Almacenamiento de archivos (feature 004; DP-015) ---
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_DDL_UPLOAD_MB=20
MAX_SAMPLE_UPLOAD_MB=200

# --- Observabilidad (opcional) ---
SENTRY_DSN=

# --- Frontend ---
BACKEND_INTERNAL_URL=http://localhost:8000
